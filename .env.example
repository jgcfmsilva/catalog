# --- Metadata ---
# TMDB (movies + series). Free key: https://www.themoviedb.org/settings/api
# Either the "API Key" (v3) or the "API Read Access Token" (v4) works.
# Anime uses Jikan (MyAnimeList) and needs no key.
TMDB_API_KEY=

# --- Seeded user (created/updated on every API start) ---
SEED_USERNAME=admin
SEED_PASSWORD='change-me'

# --- Secrets (generated) ---
JWT_SECRET=change-me
POSTGRES_PASSWORD=change-me

# --- Web ---
WEB_PORT=8090
